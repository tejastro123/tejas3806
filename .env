
# MongoDB & Backend Configuration
MONGODB_URI=mongodb+srv://tejas:tejas123@cluster0.mifutpo.mongodb.net/?appName=Cluster0
JWT_SECRET=your_jwt_secret_key_here
PORT=5000

# Redis Cache Integration (Optional - falls back to local in-memory TTL cache if unset)
# REDIS_URL=redis://127.0.0.1:6379

# Qdrant Vector DB Integration (Optional - falls back to local JSON persistent vector store if unset)
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=your_qdrant_api_key_here

# Apache Kafka Event Bus (Optional - falls back to HTTP-based direct event routing if unset)
# KAFKA_BROKERS=localhost:9092

# Meilisearch Global Search Engine (Optional - falls back to local in-memory Fuse.js search engine if unset)
# MEILISEARCH_HOST=http://localhost:7700
# MEILISEARCH_API_KEY=your_meilisearch_api_key_here